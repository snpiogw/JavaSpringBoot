<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="sample.common.dao.mapper.LoginMapper">
    <insert id="insertUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO login (username, password) VALUES (#{username}, #{password})
    </insert>
    <select id="findByUsername" resultType="sample.common.dao.entity.Login">
    SELECT id, username, password, created_at AS createdAt, updated_at AS updatedAt
    FROM login WHERE username = #{username}
</select>
</mapper>